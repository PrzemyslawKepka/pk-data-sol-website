---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations } from '../../../utils/i18n';
import { getLangFromParams, getBasePath } from '../../../utils/langHelpers';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // Get English posts since Polish content doesn't exist yet
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en');
  const languages = [undefined, 'pl'] as const;

  return languages.flatMap(lang =>
    posts.map(post => ({
      params: { lang, slug: post.slug },
      props: { post }
    }))
  );
}

const { post } = Astro.props;
const lang = getLangFromParams(Astro.params.lang);
const basePath = getBasePath(lang);
const t = useTranslations(lang);

const { Content, headings } = await post.render();

// Category badge colors
const categoryColors: Record<string, string> = {
  Technical: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  Business: 'bg-green-500/20 text-green-400 border-green-500/30'
};

// Format date as YYYY-MM-DD
const formattedDate = post.data.publishDate.toISOString().split('T')[0];

// Filter to only include h2 and h3 headings for TOC
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Get translated category name
const categoryName = t.blog.categories[post.data.category] || post.data.category;

// Get description based on language (fallback to English)
const getDescription = () => {
  if (lang === 'pl' && post.data.descriptionPl) {
    return post.data.descriptionPl;
  }
  return post.data.description;
};
---

<BaseLayout title={`${post.data.title} | ${t.blog.title}`} lang={lang}>
  <Header lang={lang} />

  <main class="pt-8">
    <article class="pt-2 pb-8">
      <div class="max-w-4xl mx-auto px-4">
        <!-- Back Link -->
        <a
          href={`${basePath}/blog`}
          class="inline-flex items-center gap-2 text-slate-400 hover:text-amber-500 transition-colors mb-8"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          {t.blog.backToBlog}
        </a>

        <!-- Hero Image -->
        {post.data.image ? (
          <div class="w-full aspect-video rounded-xl overflow-hidden mb-8 border border-slate-700">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-full object-cover object-top"
            />
          </div>
        ) : (
          <div class="w-full aspect-video rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 flex items-center justify-center mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-24 h-24 text-slate-600">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
        )}

        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class={`px-3 py-1 rounded-full text-sm font-medium border ${categoryColors[post.data.category]}`}>
              {categoryName}
            </span>
            <span class="text-slate-400 text-sm">{formattedDate}</span>
            {post.data.readTime && (
              <span class="flex items-center gap-1 text-slate-400 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {post.data.readTime} {t.blog.readTime}
              </span>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-slate-100 mb-4">{post.data.title}</h1>
          <p class="text-xl text-slate-300 leading-relaxed">{getDescription()}</p>
        </header>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map((tag: string) => (
            <span class="px-3 py-1 bg-slate-800 text-slate-400 rounded-lg border border-slate-700 text-sm">
              {tag}
            </span>
          ))}
        </div>

        <!-- Lang notice for polish language (full content is in english) -->
        {lang === 'pl' && (
        <div class="mb-12 p-4 bg-yellow-500/10 border border-yellow-500/30 rounded-lg">
          <p class="text-yellow-400 text-sm">Szczegółowa treść posta dostępna jest obecnie tylko w języku angielskim. Krótki opis po polsku znajduje się powyżej.</p>
        </div>
      )}

        <!-- Table of Contents -->
        {tocHeadings.length > 0 && (
          <nav class="mb-12 p-6 bg-slate-800/50 rounded-xl border border-slate-700">
            <h2 class="text-lg font-bold text-slate-100 mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
              {t.blog.tableOfContents}
            </h2>
            <ul class="space-y-2">
              {tocHeadings.map(heading => (
                <li class={heading.depth === 3 ? 'ml-4' : ''}>
                  <a
                    href={`#${heading.slug}`}
                    class="text-slate-400 hover:text-amber-500 transition-colors text-sm"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>
