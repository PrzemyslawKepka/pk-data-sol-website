---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogsGrid from '../../../components/BlogsGrid.vue';
import { useTranslations } from '../../../utils/i18n';
import { getLangFromParams, getBasePath, getLanguagePaths } from '../../../utils/langHelpers';
import { getCollection } from 'astro:content';
import { getBlogOrder } from '../../../config/blogOrder';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromParams(Astro.params.lang);
const basePath = getBasePath(lang);
const t = useTranslations(lang);

// Get all English blog posts (Polish content doesn't exist yet)
const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en');

// Transform posts for the Vue component
const maxOrder = allPosts.length;
const posts = allPosts.map(post => ({
  slug: post.slug,
  data: {
    title: post.data.title,
    description: post.data.description,
    descriptionPl: post.data.descriptionPl,
    publishDate: post.data.publishDate,
    category: post.data.category,
    tags: post.data.tags,
    image: post.data.image,
    readTime: post.data.readTime,
    order: maxOrder - getBlogOrder(post.slug)
  }
}));
---

<BaseLayout title={t.blog.title} lang={lang}>
  <Header lang={lang} />

  <main class="pt-8">
    <section class="pt-2 pb-8">
      <div class="max-w-7xl mx-auto px-4">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-slate-100">{t.blog.title}</h1>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto">{t.blog.subtitle}</p>
        </div>

        <!-- Blog Posts Grid with Filter -->
        <BlogsGrid
          client:load
          posts={posts}
          lang={lang}
          translations={{
            seeFullPost: t.blog.seeFullPost,
            minRead: t.blog.minRead,
            categories: t.blog.categories,
            filterByCategory: t.blog.filterByCategory,
            sorting: t.blog.sorting
          }}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
