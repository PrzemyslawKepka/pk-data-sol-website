---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../utils/i18n';

const lang = 'en'; // Default language
const t = useTranslations(lang);

// Industries data
const industries = [
  { name: 'Finance', emoji: '💰', namepl: 'Finanse' },
  { name: 'Accounting', emoji: '📊', namepl: 'Księgowość' },
  { name: 'Credit Risk', emoji: '📉', namepl: 'Ryzyko Kredytowe' },
  { name: 'Internet of Things (IoT)', emoji: '🔌', namepl: 'Internet Rzeczy (IoT)' },
  { name: 'Real Estate', emoji: '🏢', namepl: 'Nieruchomości' },
  { name: 'Social Media', emoji: '📱', namepl: 'Media Społecznościowe' }
];

// Services pipeline steps
const servicesSteps = [
  {
    number: '01',
    title: t.services.step1Title,
    items: t.services.step1Items,
    icon: '📥'
  },
  {
    number: '02',
    title: t.services.step2Title,
    items: t.services.step2Items,
    icon: '🗄️'
  },
  {
    number: '03',
    title: t.services.step3Title,
    items: t.services.step3Items,
    icon: '⚙️'
  },
  {
    number: '04',
    title: t.services.step4Title,
    items: t.services.step4Items,
    icon: '📊'
  }
];
---

<BaseLayout title="Home" lang={lang}>
  <Header lang={lang} />

  <main>
    <!-- Hero/Start Section -->
    <section id="start" class="hero-section">
      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <h1 class="hero-greeting">{t.hero.greeting}</h1>
            <p class="hero-tagline text-gradient">{t.hero.tagline}</p>
            <p class="hero-description">{t.hero.description}</p>
            <ul class="hero-points">
              <li>{t.hero.point1}</li>
              <li>{t.hero.point2}</li>
            </ul>
            <div class="hero-cta">
              <a href="#projects" class="btn btn-primary">{t.cta.viewWork}</a>
              <a href="#contact" class="btn btn-secondary">{t.cta.contactMe}</a>
            </div>
          </div>
          <div class="hero-image">
            <div class="image-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <p>Professional Photo</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.about.title}</h2>
          <p class="section-subtitle">{t.about.subtitle}</p>
        </div>

        <div class="about-content">
          <div class="about-text">
            <p class="about-description">{t.about.background}</p>

            <div class="about-stats">
              <div class="stat-card">
                <div class="stat-number">7+</div>
                <div class="stat-label">{t.about.yearsExpLabel}</div>
              </div>
              <div class="stat-card">
                <div class="stat-number">6+</div>
                <div class="stat-label">{t.about.industriesLabel}</div>
              </div>
            </div>
          </div>

          <div class="about-values">
            <h3>{t.about.valueTitle}</h3>
            <ul class="values-list">
              <li>✓ {t.about.value1}</li>
              <li>✓ {t.about.value2}</li>
              <li>✓ {t.about.value3}</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="services-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.services.title}</h2>
          <p class="section-subtitle">{t.services.subtitle}</p>
        </div>

        <div class="services-pipeline">
          {servicesSteps.map((step, index) => (
            <div class="pipeline-step">
              <div class="step-header">
                <span class="step-number">{step.number}</span>
                <span class="step-icon">{step.icon}</span>
              </div>
              <h3 class="step-title">{step.title}</h3>
              <ul class="step-items">
                {step.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
              {index < servicesSteps.length - 1 && (
                <div class="pipeline-arrow">→</div>
              )}
            </div>
          ))}
        </div>

        <div class="services-note">
          <p class="highlight">{t.services.fullStack}</p>
          <p>{t.services.flexible}</p>
        </div>

        <!-- Industries -->
        <div class="industries-section">
          <h3 class="industries-title">{t.services.industriesTitle}</h3>
          <div class="industries-grid">
            {industries.map(industry => (
              <div class="industry-pill">
                <span class="industry-emoji">{industry.emoji}</span>
                <span class="industry-name">{industry.name}</span>
              </div>
            ))}
          </div>
          <p class="industries-note">{t.services.universalStatement}</p>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.projects.title}</h2>
        </div>

        <div class="projects-placeholder">
          <div class="placeholder-card card">
            <div class="placeholder-image"></div>
            <h3>Project Example</h3>
            <p>Project cards will be displayed here with screenshots, descriptions, and links.</p>
            <p class="text-sm">Coming soon: cm-rentals, tekyous, supabase-img-linker-ui, and more...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Technologies Section -->
    <section id="technologies" class="technologies-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.technologies.title}</h2>
          <div class="tech-preface">
            <p class="highlight">{t.technologies.preface1}</p>
            <p>{t.technologies.preface2}</p>
          </div>
        </div>

        <div class="tech-placeholder">
          <div class="placeholder-card card">
            <h3>Technologies Grid</h3>
            <p>Interactive spinning tech cards will be displayed here showing:</p>
            <ul>
              <li>Python, SQL (Foundations)</li>
              <li>Pandas, Plotly, Jupyter (Data Analytics)</li>
              <li>PostgreSQL, Supabase, MS SQL, Oracle (Databases)</li>
              <li>Airflow, Cron (ETL)</li>
              <li>Streamlit, Panel (Data Apps)</li>
              <li>Flask, FastAPI, Vue.js (Full-Stack)</li>
              <li>Docker, Git, VPS (Infrastructure)</li>
              <li>VSCode, Cursor, Claude Code (AI Development)</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="blog-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.blog.title}</h2>
        </div>

        <div class="blog-placeholder">
          <div class="placeholder-card card">
            <h3>Blog Posts</h3>
            <p>Recent blog posts will be displayed here as cards.</p>
            <p class="text-sm">Blog functionality coming soon...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">{t.contact.title}</h2>
          <p class="section-subtitle">{t.contact.subtitle}</p>
        </div>

        <div class="contact-content">
          <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div class="form-group">
              <label for="name">{t.contact.nameLabel}</label>
              <input type="text" id="name" name="name" required />
            </div>

            <div class="form-group">
              <label for="email">{t.contact.emailLabel}</label>
              <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
              <label for="subject">{t.contact.subjectLabel}</label>
              <input type="text" id="subject" name="subject" />
            </div>

            <div class="form-group">
              <label for="message">{t.contact.messageLabel}</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">{t.contact.submitButton}</button>
          </form>

          <div class="contact-info">
            <div class="contact-card card">
              <h3>Email</h3>
              <p><a href="mailto:przemek@pk-data-solutions.com">przemek@pk-data-solutions.com</a></p>
            </div>

            <div class="contact-card card">
              <h3>Social</h3>
              <div class="social-links-vertical">
                <a href="https://github.com/przemyslawkepka" target="_blank">GitHub</a>
                <a href="https://linkedin.com/in/przemyslawkepka" target="_blank">LinkedIn</a>
                <a href="https://twitter.com/przemyslawkepka" target="_blank">Twitter</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
/* Hero Section */
.hero-section {
  min-height: calc(100vh - 80px);
  display: flex;
  align-items: center;
  padding: 4rem 0;
}

.hero-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

@media (max-width: 768px) {
  .hero-content {
    grid-template-columns: 1fr;
    text-align: center;
  }
}

.hero-greeting {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.hero-tagline {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 1.5rem;
}

.hero-description {
  font-size: 1.125rem;
  color: var(--color-text-secondary);
  margin-bottom: 1rem;
}

.hero-points {
  list-style: none;
  padding: 0;
  margin: 2rem 0;
}

.hero-points li {
  font-size: 1rem;
  color: var(--color-text-secondary);
  padding: 0.5rem 0;
  padding-left: 1.5rem;
  position: relative;
}

.hero-points li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--color-accent-blue);
  font-weight: bold;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  margin-top: 2rem;
}

@media (max-width: 768px) {
  .hero-cta {
    justify-content: center;
  }
}

.hero-image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-placeholder {
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-tertiary) 100%);
  border: 4px solid var(--color-accent-blue);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.image-placeholder svg {
  width: 120px;
  height: 120px;
  color: var(--color-text-secondary);
}

.image-placeholder p {
  color: var(--color-text-secondary);
  font-size: 0.875rem;
}

/* About Section */
.about-section {
  background-color: var(--color-bg-secondary);
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-title {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.section-subtitle {
  font-size: 1.25rem;
  color: var(--color-accent-blue);
}

.about-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: start;
}

@media (max-width: 768px) {
  .about-content {
    grid-template-columns: 1fr;
  }
}

.about-description {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--color-text-secondary);
  margin-bottom: 2rem;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.stat-card {
  background-color: var(--color-bg-tertiary);
  padding: 1.5rem;
  border-radius: 0.75rem;
  text-align: center;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--color-accent-blue);
}

.stat-label {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.about-values h3 {
  margin-bottom: 1.5rem;
}

.values-list {
  list-style: none;
  padding: 0;
}

.values-list li {
  padding: 0.75rem 0;
  font-size: 1.0625rem;
  color: var(--color-text-secondary);
  border-bottom: 1px solid var(--color-border);
}

.values-list li:last-child {
  border-bottom: none;
}

/* Services Section */
.services-pipeline {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
  position: relative;
}

@media (max-width: 768px) {
  .services-pipeline {
    grid-template-columns: 1fr;
  }
}

.pipeline-step {
  background-color: var(--color-bg-secondary);
  padding: 2rem;
  border-radius: 0.75rem;
  border: 1px solid var(--color-border);
  position: relative;
  transition: all 0.3s ease;
}

.pipeline-step:hover {
  border-color: var(--color-accent-blue);
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.step-number {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-accent-blue);
}

.step-icon {
  font-size: 2rem;
}

.step-title {
  font-size: 1.25rem;
  margin-bottom: 1rem;
}

.step-items {
  list-style: none;
  padding: 0;
}

.step-items li {
  padding: 0.5rem 0;
  font-size: 0.9375rem;
  color: var(--color-text-secondary);
  padding-left: 1.25rem;
  position: relative;
}

.step-items li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: var(--color-accent-blue);
}

.pipeline-arrow {
  display: none;
}

@media (min-width: 1024px) {
  .pipeline-arrow {
    display: block;
    position: absolute;
    right: -2rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    color: var(--color-accent-blue);
  }
}

.services-note {
  text-align: center;
  padding: 2rem;
  background-color: var(--color-bg-secondary);
  border-radius: 0.75rem;
  border: 2px solid var(--color-accent-blue);
  margin-bottom: 3rem;
}

.highlight {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-accent-blue);
  margin-bottom: 0.5rem;
}

.industries-section {
  margin-top: 4rem;
}

.industries-title {
  text-align: center;
  margin-bottom: 2rem;
}

.industries-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 2rem;
}

.industry-pill {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background-color: var(--color-bg-secondary);
  border-radius: 999px;
  border: 1px solid var(--color-border);
  transition: all 0.2s ease;
}

.industry-pill:hover {
  border-color: var(--color-accent-blue);
  transform: translateY(-2px);
}

.industry-emoji {
  font-size: 1.25rem;
}

.industry-name {
  font-size: 0.9375rem;
  font-weight: 500;
}

.industries-note {
  text-align: center;
  font-size: 1rem;
  color: var(--color-text-secondary);
  max-width: 800px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Projects, Technologies, Blog Sections */
.projects-section,
.technologies-section,
.blog-section {
  background-color: var(--color-bg-secondary);
}

.projects-placeholder,
.tech-placeholder,
.blog-placeholder {
  display: flex;
  justify-content: center;
}

.placeholder-card {
  max-width: 600px;
  text-align: center;
}

.placeholder-card h3 {
  margin-bottom: 1rem;
}

.placeholder-card ul {
  text-align: left;
  color: var(--color-text-secondary);
}

.placeholder-image {
  width: 100%;
  height: 200px;
  background: linear-gradient(135deg, var(--color-bg-tertiary) 0%, var(--color-bg-primary) 100%);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.text-sm {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}

/* Contact Section */
.contact-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 3rem;
  max-width: 1000px;
  margin: 0 auto;
}

@media (max-width: 768px) {
  .contact-content {
    grid-template-columns: 1fr;
  }
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-weight: 600;
  font-size: 0.9375rem;
}

.form-group input,
.form-group textarea {
  padding: 0.75rem;
  border-radius: 0.5rem;
  border: 1px solid var(--color-border);
  background-color: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-size: 1rem;
  font-family: inherit;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--color-accent-blue);
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.contact-card {
  padding: 1.5rem;
}

.contact-card h3 {
  margin-bottom: 1rem;
}

.social-links-vertical {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.social-links-vertical a {
  color: var(--color-text-secondary);
  transition: color 0.2s ease;
}

.social-links-vertical a:hover {
  color: var(--color-accent-blue);
}

.tech-preface {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 2rem;
}
</style>
