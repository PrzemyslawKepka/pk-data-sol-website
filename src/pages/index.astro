---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import TechnologiesSection from '../components/TechnologiesSection.astro';
import { useTranslations } from '../utils/i18n';
import { getCollection } from 'astro:content';
import { featuredProjects as featuredSlugs } from '../config/projectOrder';
import { featuredBlogPosts as featuredBlogSlugs } from '../config/blogOrder';
import { getYearsOfExperience } from '../utils/experience';

const lang = 'en'; // Default language
const t = useTranslations(lang);
const yearsOfExperience = getYearsOfExperience();

// Get featured projects for homepage using centralized config
const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const projectMap = new Map(allProjects.map(p => [p.slug, p]));
const featuredProjects = featuredSlugs
  .map(slug => projectMap.get(slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined)
  .slice(0, 3);

// Get featured blog posts for homepage using centralized config
const allBlogPosts = await getCollection('blog', ({ data }) => data.lang === lang);
const blogMap = new Map(allBlogPosts.map(p => [p.slug, p]));
const featuredBlogPosts = featuredBlogSlugs
  .map(slug => blogMap.get(slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined)
  .slice(0, 3);

// Industries data - 'key' must match the filter keys in ProjectsGrid.vue
const industries = [
  { key: 'Finance', name: 'Finance', emoji: '💰', namepl: 'Finanse' },
  { key: 'Accounting', name: 'Accounting', emoji: '📊', namepl: 'Księgowość' },
  { key: 'Credit Risk', name: 'Credit Risk', emoji: '📉', namepl: 'Ryzyko Kredytowe' },
  { key: 'IoT', name: 'Internet of Things (IoT)', emoji: '🔌', namepl: 'Internet Rzeczy (IoT)' },
  { key: 'Real Estate', name: 'Real Estate', emoji: '🏢', namepl: 'Nieruchomości' },
  { key: 'Social Media', name: 'Social Media', emoji: '📱', namepl: 'Media Społecznościowe' }
];

// Services pipeline steps
const servicesSteps = [
  {
    number: '01',
    title: t.services.step1Title,
    items: t.services.step1Items,
    icon: '📥'
  },
  {
    number: '02',
    title: t.services.step2Title,
    items: t.services.step2Items,
    icon: '🗄️'
  },
  {
    number: '03',
    title: t.services.step3Title,
    items: t.services.step3Items,
    icon: '⚙️'
  },
  {
    number: '04',
    title: t.services.step4Title,
    items: t.services.step4Items,
    icon: '📊'
  }
];
---

<BaseLayout title="Home" lang={lang}>
  <Header lang={lang} />

  <main class="pt-8">
    <!-- Hero/Start Section -->
    <section id="start" class="flex items-start pt-6 pb-8 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="text-center md:text-left">
            <h1 class="text-4xl md:text-5xl font-bold mb-2 text-slate-100">{t.hero.greeting}</h1>
            <p class="text-3xl md:text-4xl font-extrabold mb-6 text-gradient">{t.hero.tagline}</p>
            <p class="text-lg text-slate-300 mb-4">{t.hero.description}</p>
            <ul class="list-none p-0">
              <li class="text-base text-slate-300 py-2 pl-6 relative before:content-['→'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.hero.point1}</li>
              <li class="text-base text-slate-300 py-2 pl-6 relative before:content-['→'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.hero.point2}</li>
              <li class="text-base text-slate-300 py-2 pl-6 relative before:content-['→'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.hero.point3}</li>
            </ul>
            <div class="flex gap-4 mt-8 justify-center md:justify-start">
              <a href="#projects" class="inline-block px-6 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-amber-500 text-white hover:bg-amber-600 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/30">{t.cta.viewWork}</a>
              <a href="#contact" class="inline-block px-6 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-transparent text-amber-500 border-2 border-amber-500 hover:bg-amber-500 hover:text-white">{t.cta.contactMe}</a>
            </div>
          </div>
          <div class="flex justify-center items-center">
            <img
              src="/images/professional-photo/professional-photo.png"
              alt="Przemysław Kępka"
              class="w-[350px] h-[350px] rounded-full border-4 border-amber-500 object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-8 bg-slate-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-4">
          <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.about.title}</h2>
          <p class="text-xl text-amber-500">{t.about.subtitle}</p>
        </div>

        <!-- Description and Fact Boxes -->
        <div class="mb-5">
          <p class="text-lg leading-relaxed text-slate-300 mb-4 max-w-4xl mx-auto text-center">{t.about.background.replace('{years}', String(yearsOfExperience))}</p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
            <div class="bg-slate-700 p-3 rounded-xl text-center">
              <div class="text-3xl font-extrabold text-amber-500">{yearsOfExperience}+</div>
              <div class="text-xs text-slate-400 uppercase tracking-wide">{t.about.yearsExpLabel}</div>
            </div>
            <div class="bg-slate-700 p-3 rounded-xl text-center">
              <div class="text-3xl font-extrabold text-amber-500">{t.about.industriesCount}</div>
              <div class="text-xs text-slate-400 uppercase tracking-wide">{t.about.industriesLabel}</div>
            </div>
            <div class="bg-slate-700 p-3 rounded-xl text-center">
              <div class="text-xs text-slate-400 uppercase tracking-wide">{t.about.timeSavedPrefix}</div>
              <div class="text-3xl font-extrabold text-amber-500">{t.about.timeSaved}</div>
              <div class="text-xs text-slate-400 uppercase tracking-wide">{t.about.timeSavedLabel}</div>
              <!-- Description available in t.about.timeSavedDesc if needed -->
            </div>
            <div class="bg-slate-700 p-3 rounded-xl text-center">
              <div class="text-3xl font-extrabold text-amber-500">{t.about.solutionsCount}</div>
              <div class="text-xs text-slate-400 uppercase tracking-wide">{t.about.solutionsLabel}</div>
            </div>
          </div>
        </div>

        <!-- What I Bring -->
        <div class="mb-2 max-w-2xl mx-auto">
          <h3 class="text-2xl font-bold mb-3 text-slate-100 text-center">{t.about.valueTitle}</h3>
          <ul class="list-none p-0">
            <li class="py-2 text-[1.0625rem] text-slate-300 border-b border-slate-700 pl-6 relative before:content-['✓'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.about.value1}</li>
            <li class="py-2 text-[1.0625rem] text-slate-300 border-b border-slate-700 pl-6 relative before:content-['✓'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.about.value2}</li>
            <li class="py-2 text-[1.0625rem] text-slate-300 pl-6 relative before:content-['✓'] before:absolute before:left-0 before:text-amber-500 before:font-bold">{t.about.value3}</li>
          </ul>
        </div>

        <!-- Industry Experience -->
        <div class="mt-2">
          <h3 class="text-2xl font-bold text-center mb-2 text-slate-100">{t.about.industriesTitle}</h3>
          <p class="text-center text-sm text-slate-500 mb-3">{t.about.industriesHint}</p>
          <div class="flex flex-wrap justify-center gap-3 mb-4">
            {industries.map(industry => (
              <a href={`/projects?industry=${encodeURIComponent(industry.key)}`} class="flex items-center gap-2 py-3 px-6 bg-slate-700 rounded-full border border-slate-600 transition-all hover:border-amber-500 hover:-translate-y-0.5 cursor-pointer">
                <span class="text-xl">{industry.emoji}</span>
                <span class="text-[0.9375rem] font-medium text-slate-100">{industry.name}</span>
              </a>
            ))}
          </div>
          <p class="text-center text-base text-slate-400 max-w-3xl mx-auto leading-relaxed">{t.about.industriesStatement}</p>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-8">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.services.title}</h2>
          <p class="text-xl text-amber-500">{t.services.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8 relative">
          {servicesSteps.map((step, index) => (
            <div class="bg-slate-800 p-8 rounded-xl border border-slate-700 relative transition-all hover:border-amber-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30">
              <div class="flex justify-between items-center mb-4">
                <span class="text-2xl font-extrabold text-amber-500">{step.number}</span>
                <span class="text-3xl">{step.icon}</span>
              </div>
              <h3 class="text-xl font-bold mb-4 text-slate-100">{step.title}</h3>
              <ul class="list-none p-0">
                {step.items.map(item => (
                  <li class="py-2 text-[0.9375rem] text-slate-400 pl-5 relative before:content-['•'] before:absolute before:left-0 before:text-amber-500">{item}</li>
                ))}
              </ul>
              {index < servicesSteps.length - 1 && (
                <div class="hidden lg:block absolute -right-8 top-1/2 -translate-y-1/2 text-3xl text-amber-500">→</div>
              )}
            </div>
          ))}
        </div>

        <div class="p-8 bg-slate-800 rounded-xl border-2 border-amber-500">
          <div class="text-center mb-6">
            <p class="text-lg font-bold text-amber-500 mb-2">{t.services.fullStack}</p>
            <p class="text-slate-300">{t.services.flexible}</p>
            <p class="text-slate-300">{t.services.flexible2}</p>
          </div>

          <!-- Service Scope & Client Scope -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto">
            <!-- Service Scope Frame -->
            <div class="bg-slate-700/30 rounded-xl p-4 border border-slate-600 transition-all hover:border-amber-500">
              <h4 class="text-sm font-bold text-slate-100 mb-3 border-b border-slate-600 pb-2">{t.services.serviceScopeTitle}</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 rounded-xl border border-slate-600 bg-slate-800 flex items-center justify-center shrink-0">
                    <span class="text-3xl">{t.services.serviceScopeSpecificIcon}</span>
                  </div>
                  <h5 class="text-sm font-semibold text-slate-100 text-center">{t.services.serviceScopeSpecificTitle}</h5>
                  <p class="text-slate-400 text-xs text-center">{t.services.serviceScopeSpecificDesc}</p>
                </div>
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 rounded-xl border border-slate-600 bg-slate-800 flex items-center justify-center shrink-0">
                    <span class="text-3xl">{t.services.serviceScopeFullIcon}</span>
                  </div>
                  <h5 class="text-sm font-semibold text-slate-100 text-center">{t.services.serviceScopeFullTitle}</h5>
                  <p class="text-slate-400 text-xs text-center">{t.services.serviceScopeFullDesc}</p>
                </div>
              </div>
            </div>
            <!-- Client Scope Frame -->
            <div class="bg-slate-700/30 rounded-xl p-4 border border-slate-600 transition-all hover:border-amber-500">
              <h4 class="text-sm font-bold text-slate-100 mb-3 border-b border-slate-600 pb-2">{t.services.clientScopeTitle}</h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 rounded-xl border border-slate-600 bg-slate-800 flex items-center justify-center shrink-0">
                    <span class="text-3xl">{t.services.clientScopeSmbIcon}</span>
                  </div>
                  <h5 class="text-sm font-semibold text-slate-100 text-center">{t.services.clientScopeSmbTitle}</h5>
                  <p class="text-slate-400 text-xs text-center">{t.services.clientScopeSmbDesc}</p>
                </div>
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 rounded-xl border border-slate-600 bg-slate-800 flex items-center justify-center shrink-0">
                    <span class="text-3xl">{t.services.clientScopeLargeIcon}</span>
                  </div>
                  <h5 class="text-sm font-semibold text-slate-100 text-center">{t.services.clientScopeLargeTitle}</h5>
                  <p class="text-slate-400 text-xs text-center">{t.services.clientScopeLargeDesc}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Delivery Pipeline -->
        <div class="mt-10">
          <h3 class="text-2xl font-bold text-center mb-2 text-slate-100">{t.services.pipelineTitle}</h3>
          <p class="text-center text-amber-500 mb-8">{t.services.pipelineSubtitle}</p>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative">
            <div class="relative">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-10 h-10 rounded-full bg-amber-500 flex items-center justify-center text-white font-bold text-lg shrink-0">1</div>
                <h4 class="text-lg font-bold text-slate-100">{t.services.pipelineStep1Title}</h4>
              </div>
              <div class="border-b border-slate-700 mb-3 ml-14"></div>
              <p class="text-slate-400 text-[0.9375rem] pl-14">{t.services.pipelineStep1Desc}</p>
              <div class="hidden lg:block absolute -right-5 top-5 -translate-y-1/2 text-2xl text-amber-500">→</div>
            </div>

            <div class="relative">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-10 h-10 rounded-full bg-amber-500 flex items-center justify-center text-white font-bold text-lg shrink-0">2</div>
                <h4 class="text-lg font-bold text-slate-100">{t.services.pipelineStep2Title}</h4>
              </div>
              <div class="border-b border-slate-700 mb-3 ml-14"></div>
              <p class="text-slate-400 text-[0.9375rem] pl-14">{t.services.pipelineStep2Desc}</p>
              <div class="hidden lg:block absolute -right-5 top-5 -translate-y-1/2 text-2xl text-amber-500">→</div>
            </div>

            <div class="relative">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-10 h-10 rounded-full bg-amber-500 flex items-center justify-center text-white font-bold text-lg shrink-0">3</div>
                <h4 class="text-lg font-bold text-slate-100">{t.services.pipelineStep3Title}</h4>
              </div>
              <div class="border-b border-slate-700 mb-3 ml-14"></div>
              <p class="text-slate-400 text-[0.9375rem] pl-14">{t.services.pipelineStep3Desc}</p>
              <div class="hidden lg:block absolute -right-5 top-5 -translate-y-1/2 text-2xl text-amber-500">→</div>
            </div>

            <div>
              <div class="flex items-center gap-4 mb-3">
                <div class="w-10 h-10 rounded-full bg-amber-500 flex items-center justify-center text-white font-bold text-lg shrink-0">4</div>
                <h4 class="text-lg font-bold text-slate-100">{t.services.pipelineStep4Title}</h4>
              </div>
              <div class="border-b border-slate-700 mb-3 ml-14"></div>
              <p class="text-slate-400 text-[0.9375rem] pl-14">{t.services.pipelineStep4Desc}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-8 bg-slate-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.projects.title}</h2>
          <p class="text-xl text-slate-300">{t.projects.subtitle}</p>
        </div>

        {featuredProjects.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
              {featuredProjects.map(project => (
                <ProjectCard
                  project={project}
                  translations={{
                    seeMore: t.projects.seeMore,
                    viewGithub: t.projects.viewGithub,
                    viewLive: t.projects.viewLive
                  }}
                />
              ))}
            </div>

            <div class="text-center">
              <a
                href="/projects"
                class="inline-block px-8 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-transparent text-amber-500 border-2 border-amber-500 hover:bg-amber-500 hover:text-white"
              >
                {t.projects.viewAllProjects}
              </a>
            </div>
          </>
        ) : (
          <div class="text-center">
            <p class="text-slate-400 mb-8">Projects coming soon...</p>
            <a
              href="/projects"
              class="inline-block px-8 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-amber-500 text-white hover:bg-amber-600"
            >
              {t.projects.viewAllProjects}
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Technologies Section -->
    <TechnologiesSection translations={t.technologies} />

    <!-- Blog Section -->
    <section id="blog" class="py-8 bg-slate-800">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.blog.title}</h2>
          <p class="text-xl text-slate-300">{t.blog.subtitle}</p>
        </div>

        {featuredBlogPosts.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
              {featuredBlogPosts.map(post => (
                <BlogCard
                  post={post}
                  translations={{
                    seeFullPost: t.blog.seeFullPost,
                    minRead: t.blog.minRead
                  }}
                />
              ))}
            </div>

            <div class="text-center">
              <a
                href="/blog"
                class="inline-block px-8 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-transparent text-amber-500 border-2 border-amber-500 hover:bg-amber-500 hover:text-white"
              >
                {t.blog.allPosts}
              </a>
            </div>
          </>
        ) : (
          <div class="text-center">
            <p class="text-slate-400 mb-8">Blog posts coming soon...</p>
            <a
              href="/blog"
              class="inline-block px-8 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-amber-500 text-white hover:bg-amber-600"
            >
              {t.blog.allPosts}
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-8">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.contact.title}</h2>
          <p class="text-xl text-amber-500">{t.contact.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-12 max-w-4xl mx-auto">
          <form class="flex flex-col gap-6" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div class="flex flex-col gap-2">
              <label for="name" class="font-semibold text-[0.9375rem] text-slate-100">{t.contact.nameLabel}</label>
              <input type="text" id="name" name="name" required class="p-3 rounded-lg border border-slate-700 bg-slate-800 text-slate-100 text-base focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/10" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="font-semibold text-[0.9375rem] text-slate-100">{t.contact.emailLabel}</label>
              <input type="email" id="email" name="email" required class="p-3 rounded-lg border border-slate-700 bg-slate-800 text-slate-100 text-base focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/10" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="subject" class="font-semibold text-[0.9375rem] text-slate-100">{t.contact.subjectLabel}</label>
              <input type="text" id="subject" name="subject" class="p-3 rounded-lg border border-slate-700 bg-slate-800 text-slate-100 text-base focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/10" />
            </div>

            <div class="flex flex-col gap-2">
              <label for="message" class="font-semibold text-[0.9375rem] text-slate-100">{t.contact.messageLabel}</label>
              <textarea id="message" name="message" rows="6" required class="p-3 rounded-lg border border-slate-700 bg-slate-800 text-slate-100 text-base font-sans focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/10"></textarea>
            </div>

            <button type="submit" class="inline-block px-6 py-3 rounded-lg font-semibold text-center transition-all cursor-pointer bg-amber-500 text-white border-none hover:bg-amber-600 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/30">{t.contact.submitButton}</button>
          </form>

          <div class="flex flex-col gap-6">
            <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30 hover:border-amber-500">
              <h3 class="text-lg font-bold mb-4 text-slate-100">Email</h3>
              <p class="text-slate-300"><a href="mailto:przemek@pk-data-solutions.com" class="text-amber-500 hover:text-amber-600 transition-colors">przemek@pk-data-solutions.com</a></p>
            </div>

            <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30 hover:border-amber-500">
              <h3 class="text-lg font-bold mb-4 text-slate-100">Social</h3>
              <div class="flex flex-col gap-3">
                <a href="https://github.com/przemyslawkepka" target="_blank" class="text-slate-400 hover:text-amber-500 transition-colors">GitHub</a>
                <a href="https://linkedin.com/in/przemyslawkepka" target="_blank" class="text-slate-400 hover:text-amber-500 transition-colors">LinkedIn</a>
                <a href="https://twitter.com/przemyslawkepka" target="_blank" class="text-slate-400 hover:text-amber-500 transition-colors">Twitter</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
