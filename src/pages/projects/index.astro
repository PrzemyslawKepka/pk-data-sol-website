---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectsGrid from '../../components/ProjectsGrid.vue';
import { useTranslations } from '../../utils/i18n';
import { getCollection } from 'astro:content';
import { getProjectOrder } from '../../config/projectOrder';

const lang = 'en';
const t = useTranslations(lang);

// Get all English projects
const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);

// Transform projects for the Vue component
// Order is derived from centralized config (lower index = higher priority, so we invert it)
const maxOrder = allProjects.length;
const projects = allProjects.map(project => ({
  slug: project.slug,
  data: {
    title: project.data.title,
    description: project.data.description,
    categories: project.data.categories,
    technologies: project.data.technologies,
    github: project.data.github,
    liveUrl: project.data.liveUrl,
    image: project.data.image,
    projectType: project.data.projectType,
    company: project.data.company,
    year: project.data.year,
    industry: project.data.industry,
    isCommercial: project.data.isCommercial,
    order: maxOrder - getProjectOrder(project.slug) // Invert so first in config = highest order
  }
}));
---

<BaseLayout title={t.projects.title} lang={lang}>
  <Header lang={lang} />

  <main class="pt-8">
    <section class="pt-2 pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4">
        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-slate-100">{t.projects.title}</h1>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto">{t.projects.subtitle}</p>
        </div>

        <!-- Projects Grid with Filter -->
        <ProjectsGrid
          client:load
          projects={projects}
          translations={{
            projectTypes: t.projects.projectTypes,
            projectTypesDesc: t.projects.projectTypesDesc,
            categories: t.projects.categories,
            industries: t.projects.industries,
            seeMore: t.projects.seeMore,
            viewGithub: t.projects.viewGithub,
            viewLive: t.projects.viewLive,
            sideNote: t.projects.sideNote,
            fteNote: t.projects.fteNote
          }}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
