  }
];
---

<section id="technologies" class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.title}</h2>
      <div class="text-center max-w-xl mx-auto mt-4">
        <p class="text-lg font-bold text-amber-500 mb-2">{t.preface1}</p>
        <p class="text-slate-300">{t.preface2}</p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {categories.map(category => (
        <div class="tech-category">
          <h3 class="text-lg font-bold text-slate-100 mb-2 border-b border-slate-700 pb-2">
            {category.title}
          </h3>
          {category.description && (
            <p class="text-xs text-slate-400 mb-4">{category.description}</p>
          )}
          <div class="flex flex-wrap gap-3 justify-start">
            {category.technologies.map(tech => (
              <TechCard
                client:visible
                name={tech.name}
                description={tech.description}
                icon={tech.icon}
                isLearning={tech.isLearning || false}
                learningLabel={t.learning}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-category {
    background: rgb(30, 41, 59); /* slate-800 */
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgb(51, 65, 85); /* slate-700 */
    transition: all 0.3s ease;
  }

  .tech-category:hover {
    border-color: rgb(245, 158, 11); /* amber-500 */
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5);
  }
</style>
