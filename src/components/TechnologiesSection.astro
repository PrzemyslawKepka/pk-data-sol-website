---
import TechCard from './TechCard.vue';

interface Props {
  translations: {
    title: string;
    preface1: string;
    preface2: string;
    learning: string;
    foundations: string;
    foundationsDesc: string;
    dataManipulation: string;
    databases: string;
    etl: string;
    dataApps: string;
    fullStack: string;
    automation: string;
    infrastructure: string;
    ides: string;
  };
}

const { translations: t } = Astro.props;

// Technology icon paths
const icons = {
  python: '/images/icons/tools/python-original.svg',
  sql: '/images/icons/tools/azuresqldatabase-original.svg',
  pandas: '/images/icons/tools/pandas-original.svg',
  plotly: '/images/icons/tools/plotly-original.svg',
  jupyter: '/images/icons/tools/jupyter-original.svg',
  excel: '/images/icons/tools/microsoft-excel-icon.svg',
  postgresql: '/images/icons/tools/postgresql-original.svg',
  supabase: '/images/icons/tools/supabase-original.svg',
  airflow: '/images/icons/tools/apacheairflow-original.svg',
  cron: '/images/icons/tools/cmd-terminal-icon.svg',
  streamlit: '/images/icons/tools/streamlit-original.svg',
  panel: '/images/icons/tools/panel-logo.svg',
  flask: '/images/icons/tools/flask-original.svg',
  fastapi: '/images/icons/tools/fastapi-original.svg',
  vuejs: '/images/icons/tools/vuejs-original.svg',
  n8n: '/images/icons/tools/n8n-color.svg',
  docker: '/images/icons/tools/docker-original.svg',
  git: '/images/icons/tools/git-original.svg',
  vps: '/images/icons/tools/cpu-server-icon.svg',
  cloud: '/images/icons/tools/cloud-services-icon.svg',
  vscode: '/images/icons/tools/vscode-original.svg',
  cursor: '/images/icons/tools/cursor.svg',
  claudecode: '/images/icons/tools/claude-color.svg',
};

// Technology data organized by category
const categories = [
  {
    id: 'foundations',
    title: t.foundations,
    description: t.foundationsDesc,
    technologies: [
      { name: 'Python', icon: icons.python, description: 'Primary language for data engineering, automation, and web development' },
      { name: 'SQL', icon: icons.sql, description: 'Database querying, data modeling, and analytics' }
    ]
  },
  {
    id: 'dataManipulation',
    title: t.dataManipulation,
    technologies: [
      { name: 'Pandas', icon: icons.pandas, description: 'Data manipulation and analysis' },
      { name: 'Plotly', icon: icons.plotly, description: 'Interactive visualizations and dashboards' },
      { name: 'Jupyter', icon: icons.jupyter, description: 'Exploratory data analysis and reporting' },
      { name: 'Excel', icon: icons.excel, description: 'Good old Excel. Usually I make processes Excel-free, but sometimes you have to use it' }
    ]
  },
  {
    id: 'databases',
    title: t.databases,
    description: t.databasesDesc,
    technologies: [
      { name: 'PostgreSQL', icon: icons.postgresql, description: 'Primary database, staple nowadays' },
      { name: 'Supabase', icon: icons.supabase, description: 'Backend-as-a-service with PostgreSQL' }
    ]
  },
  {
    id: 'etl',
    title: t.etl,
    technologies: [
      { name: 'Airflow', icon: icons.airflow, description: 'Workflow orchestration and ETL pipelines.\nHeavyweight.' },
      { name: 'Cron', icon: icons.cron, description: 'Unix-based task scheduling.\nLightweight.' }
    ]
  },
  {
    id: 'dataApps',
    title: t.dataApps,
    technologies: [
      { name: 'Streamlit', icon: icons.streamlit, description: 'Python-based data apps' },
      { name: 'Panel', icon: icons.panel, description: 'Interactive dashboards and reports' }
    ]
  },
  {
    id: 'fullStack',
    title: t.fullStack,
    technologies: [
      { name: 'Flask', icon: icons.flask, description: 'Python web framework' },
      { name: 'FastAPI', icon: icons.fastapi, description: 'Modern Python API framework', isLearning: true },
      { name: 'Vue.js', icon: icons.vuejs, description: 'Progressive JavaScript framework', isLearning: true }
    ]
  },
  {
    id: 'automation',
    title: t.automation,
    technologies: [
      { name: 'Python', icon: icons.python, description: "Yes, it's python all over again." },
      { name: 'n8n', icon: icons.n8n, description: 'Workflow automation platform', isLearning: true }
    ]
  },
  {
    id: 'infrastructure',
    title: t.infrastructure,
    technologies: [
      { name: 'Git', icon: icons.git, description: 'Version control' },
      { name: 'Docker', icon: icons.docker, description: 'Containerization and deployment' },
      { name: 'VPS', icon: icons.vps, description: 'Self-hosted server management' },
      { name: 'Cloud', icon: icons.cloud, description: 'Cloud infrastructure and services', isLearning: true }
    ]
  },
  {
    id: 'ides',
    title: t.ides,
    technologies: [
      { name: 'VSCode', icon: icons.vscode, description: 'Primary code editor' },
      { name: 'Cursor', icon: icons.cursor, description: 'AI-powered development environment' },
      { name: 'Claude Code', icon: icons.claudecode, description: 'AI pair programming assistant' }
    ]
  }
];
---

<section id="technologies" class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-2 text-slate-100">{t.title}</h2>
      <div class="text-center max-w-xl mx-auto mt-4">
        <p class="text-lg font-bold text-amber-500 mb-2">{t.preface1}</p>
        <p class="text-slate-300">{t.preface2}</p>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {categories.map(category => (
        <div class="tech-category">
          <h3 class="text-lg font-bold text-slate-100 mb-2 border-b border-slate-700 pb-2">
            {category.title}
          </h3>
          {category.description && (
            <p class="text-xs text-slate-400 mb-4">{category.description}</p>
          )}
          <div class="flex flex-wrap gap-3 justify-start">
            {category.technologies.map(tech => (
              <TechCard
                client:visible
                name={tech.name}
                description={tech.description}
                icon={tech.icon}
                isLearning={tech.isLearning || false}
                learningLabel={t.learning}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-category {
    background: rgb(30, 41, 59); /* slate-800 */
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgb(51, 65, 85); /* slate-700 */
    transition: all 0.3s ease;
  }

  .tech-category:hover {
    border-color: rgb(245, 158, 11); /* amber-500 */
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5);
  }
</style>
