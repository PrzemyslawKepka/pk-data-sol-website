---
import LanguageSwitcher from './LanguageSwitcher.vue';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { text: t.nav.start, href: '/#start' },
  { text: t.nav.about, href: '/#about' },
  { text: t.nav.services, href: '/#services' },
  { text: t.nav.projects, href: '/#projects' },
  { text: t.nav.technologies, href: '/#technologies' },
  { text: t.nav.blog, href: '/#blog' },
  { text: t.nav.contact, href: '/#contact' }
];
---

<header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur-sm border-b border-slate-700 shadow-md">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center py-4">
      <!-- Left: Logo and Name -->
      <a href="/" class="flex items-center gap-4 no-underline hover:opacity-90 transition-opacity">
        <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-amber-600 rounded-lg flex items-center justify-center font-extrabold text-xl text-white">
          <span class="tracking-wide">PK</span>
        </div>
        <div class="flex flex-col">
          <h1 class="text-lg font-bold leading-tight text-slate-100">Przemysław Kępka</h1>
          <p class="text-sm font-medium text-amber-500">PK Data Solutions</p>
        </div>
      </a>

      <!-- Right: Navigation (Desktop) -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-[0.9375rem] font-medium text-slate-300 hover:text-amber-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-amber-500 after:transition-all hover:after:w-full"
          >
            {link.text}
          </a>
        ))}

        <!-- Social Links -->
        <div class="flex gap-3 pl-4 border-l border-slate-700">
          <a href="https://github.com/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://linkedin.com/in/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://twitter.com/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>

        <!-- Language Switcher -->
        <LanguageSwitcher client:load />
      </nav>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-button" class="block lg:hidden bg-transparent border-none text-slate-100 cursor-pointer" aria-label="Toggle menu" aria-expanded="false">
        <svg class="w-6 h-6 hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <nav id="mobile-menu" class="hidden lg:hidden border-t border-slate-700">
      <div class="flex flex-col py-4">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="mobile-nav-link px-4 py-3 text-base font-medium text-slate-300 hover:text-amber-500 hover:bg-slate-800/50 transition-colors"
          >
            {link.text}
          </a>
        ))}

        <!-- Social Links (Mobile) -->
        <div class="flex gap-4 px-4 pt-4 mt-2 border-t border-slate-700">
          <a href="https://github.com/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://linkedin.com/in/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a href="https://twitter.com/przemyslawkepka" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="text-slate-300 hover:text-amber-500 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>

        <!-- Language Switcher (Mobile) -->
        <div class="px-4 pt-4">
          <LanguageSwitcher client:load />
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = menuButton?.querySelector('.hamburger-icon');
    const closeIcon = menuButton?.querySelector('.close-icon');

    menuButton?.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';

      // Toggle menu visibility
      mobileMenu?.classList.toggle('hidden');

      // Toggle icons
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');

      // Update aria-expanded
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    });

    // Close menu when clicking on a nav link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        menuButton?.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>
